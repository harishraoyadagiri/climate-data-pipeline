# ─────────────────────────────────────────────────
# Climate Data Pipeline — Streamlit Dashboard
# ─────────────────────────────────────────────────
FROM python:3.11-slim

LABEL maintainer="haris" \
      description="Climate Data Pipeline — Streamlit analytics dashboard"

WORKDIR /app

# Install Python deps
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy dashboard + config
COPY config.py dashboard.py ./

# Streamlit config: disable CORS, enable wide mode
RUN mkdir -p /root/.streamlit && \
    echo '[server]\nheadless = true\nport = 8502\nenableCORS = false\n\n[browser]\ngatherUsageStats = false' \
    > /root/.streamlit/config.toml

EXPOSE 8502

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8502/_stcore/health')"

ENTRYPOINT ["streamlit", "run", "dashboard.py", "--server.port=8502", "--server.address=0.0.0.0"]
